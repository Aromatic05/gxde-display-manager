load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/qt:qt.bzl", "gxdm_configure_file", "qt_cc_library")

package(default_visibility = ["//visibility:public"])

# Generated Constants.h
gxdm_configure_file(
    name = "constants_h",
    src = "Constants.h.in",
    out = "Constants.h",
)

cc_library(
    name = "constants",
    hdrs = ["Constants.h"],
    includes = ["."],
)

# Shared sources pulled
qt_cc_library(
    name = "common",
    srcs = [
        "Configuration.cpp",
        "ConfigReader.cpp",
        "SafeDataStream.cpp",
        "Session.cpp",
        "SocketWriter.cpp",
        "ThemeConfig.cpp",
        "ThemeMetadata.cpp",
        "XAuth.cpp",
        "SignalHandler.cpp",
        "VirtualTerminal.cpp",
    ],
    hdrs = [
        "Configuration.h",
        "ConfigReader.h",
        "MessageHandler.h",
        "Messages.h",
        "SafeDataStream.h",
        "Session.h",
        "SocketWriter.h",
        "ThemeConfig.h",
        "ThemeMetadata.h",
        "SignalHandler.h",
        "VirtualTerminal.h",
        "XAuth.h",
    ],
    moc_hdrs = [
        "ThemeConfig.h",
        "ThemeMetadata.h",
        "SignalHandler.h",
    ],
    linkopts = ["-lXau"],
    deps = [":constants"],
)

# Wallpaper, cursor, scale and OS defaults shared by the classic and neo
# greeters.
qt_cc_library(
    name = "greeter_appearance",
    srcs = [
        "GreeterAppearance.cpp",
        "GreeterCursor.cpp",
        "GreeterScale.cpp",
        "SystemDefaults.cpp",
    ],
    hdrs = [
        "GreeterAppearance.h",
        "GreeterCursor.h",
        "GreeterScale.h",
        "SystemDefaults.h",
    ],
    linkopts = [
        "-lX11",
        "-lXcursor",
        "-lXfixes",
        "-lXrandr",
    ],
)

# Fingerprint login next to the password: the state machine shared by the lock
# screen and the greeter, and the fprintd probe shared by the lock and daemon.
qt_cc_library(
    name = "fingerprint_session",
    srcs = ["FingerprintSession.cpp"],
    hdrs = ["FingerprintSession.h"],
    includes = ["."],
    moc_hdrs = ["FingerprintSession.h"],
)

qt_cc_library(
    name = "fingerprint_probe",
    srcs = ["FingerprintProbe.cpp"],
    hdrs = ["FingerprintProbe.h"],
    includes = ["."],
)
